# Django (project-specific)
# =====================================================================

# Local database (regenerate with: python manage.py migrate && bootstrap)
myproject/db.sqlite3
myproject/db.sqlite3-journal

# Collected static files (output of `collectstatic`)
myproject/staticfiles/

# User-uploaded media (photos, videos, posters, logos)
myproject/media/

# Django logs
*.log

