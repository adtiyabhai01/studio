{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r myproject/requirements.txt",
  "buildCommand": "python myproject/manage.py collectstatic --noinput",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  }
}
